{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "portal": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "defaultConfiguration": "production",
          "configurations": {
            "production": {},
            "development": { "optimization": false, "sourceMap": true, "outputHashing": "none" }
          },
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "styles": ["src/styles.css"],
            "outputPath": "dist/portal",
            "assets": [],
            "optimization": {
              "scripts": true,
              "styles": { "minify": true, "inlineCritical": false },
              "fonts": false
            },
            "sourceMap": false,
            "outputHashing": "all",
            "budgets": [
              { "type": "initial", "maximumWarning": "700kB", "maximumError": "1MB" }
            ]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "portal:build" }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": { "tsConfig": "tsconfig.spec.json", "runner": "vitest" }
        }
      }
    }
  }
}
